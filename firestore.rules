rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGlobalAdmin() {
      return request.auth != null && request.auth.token.globalAdmin == true;
    }

    // Tournaments root collection
    match /tournaments/{tournamentId} {
      function isTournamentAdmin() {
        return isGlobalAdmin() || (
          request.auth != null && (
            get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid ||
            (
              "admins" in get(/databases/$(database)/documents/tournaments/$(tournamentId)).data &&
              request.auth.uid in get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.admins &&
              get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.admins[request.auth.uid] == true
            ) ||
            (
              exists(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.role == "admin"
            )
          )
        );
      }

      function isAssignedAssistant() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.role == "dataEntry";
      }

      allow read: if isTournamentAdmin() || isAssignedAssistant();
      // Only global admins create tournaments (matches the hub's Create button).
      allow create: if isGlobalAdmin();
      // Admins and staff admins may edit a tournament but never its ownership;
      // only the owner (or a global admin) may change the admin list.
      allow update: if isGlobalAdmin() || (
        isTournamentAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ownerId"]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["admins"]) ||
          resource.data.ownerId == request.auth.uid
        )
      );
      allow delete: if isTournamentAdmin();

      // Tournament records and private participant data are administrator-only.
      match /{collection}/{document} {
        allow read: if collection != "staff" && collection != "syncConflicts" &&
          collection != "auditEvents" && collection != "auditReleases" && collection != "data" &&
          isTournamentAdmin();
        allow create, delete: if collection != "staff" && collection != "syncConflicts" &&
          collection != "auditEvents" && collection != "auditReleases" && collection != "data" &&
          isTournamentAdmin();
        allow update: if collection != "staff" && collection != "syncConflicts" &&
          collection != "auditEvents" && collection != "auditReleases" && collection != "data" &&
          isTournamentAdmin();
      }

      match /staff/{staffId} {
        allow read, write: if isTournamentAdmin();
      }

      // Conflicting cloud versions are append-only recovery records.
      match /syncConflicts/{conflictId} {
        allow read: if isTournamentAdmin();
        allow create: if isTournamentAdmin();
        allow update, delete: if false;
      }

      // Audit events are append-only; only tournament administrators may read them.
      match /auditEvents/{eventId} {
        allow read: if isTournamentAdmin();
        allow create: if isTournamentAdmin() &&
          request.resource.data.id == eventId &&
          request.resource.data.tournamentId == tournamentId &&
          (
            (request.resource.data.actorType == "user" &&
              request.resource.data.actorId == request.auth.uid) ||
            request.resource.data.actorType == "system"
          );
        allow update, delete: if false;
      }

      // Released audit snapshots are written only by the authorized server route.
      match /auditReleases/{releaseId} {
        allow read, write: if false;
      }

      // Legacy bundled tournament data is administrator-only.
      match /data/{document} {
        allow read, write: if isTournamentAdmin();
      }
    }

    // Slug registry: tournamentSlugs/{slug} = { tournamentId }. Written in the
    // same transaction as the tournament, so post-write state is checked.
    function isAdminOfTournamentAfter(tournamentId) {
      return request.auth != null && (
        getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid ||
        getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get("admins", {}).get(request.auth.uid, false) == true
      );
    }

    match /tournamentSlugs/{slug} {
      allow read: if request.auth != null;
      allow create: if isGlobalAdmin() || (
        request.resource.data.keys().hasOnly(["tournamentId"]) &&
        request.resource.data.tournamentId is string &&
        isAdminOfTournamentAfter(request.resource.data.tournamentId) &&
        getAfter(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.slug == slug
      );
      allow update: if isGlobalAdmin() || (
        request.resource.data.keys().hasOnly(["tournamentId"]) &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        isAdminOfTournamentAfter(resource.data.tournamentId)
      );
      allow delete: if isGlobalAdmin() || (
        isAdminOfTournamentAfter(resource.data.tournamentId) &&
        getAfter(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.slug != slug
      );
    }

    // Direct users collection for profile / tournaments list
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if isGlobalAdmin();
    }
  }
}
