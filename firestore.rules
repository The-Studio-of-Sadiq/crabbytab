rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGlobalAdmin() {
      return request.auth != null && request.auth.token.globalAdmin == true;
    }

    // Tournaments root collection
    match /tournaments/{tournamentId} {
      function isTournamentAdmin() {
        return isGlobalAdmin();
      }

      function isAssignedAssistant() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.role == "dataEntry";
      }

      allow read: if request.auth == null || isTournamentAdmin() || isAssignedAssistant();
      allow create: if isGlobalAdmin();
      allow update, delete: if isTournamentAdmin();

      // Tournament records and private participant data are administrator-only.
      match /{collection}/{document} {
        allow read: if collection != "staff" && collection != "syncConflicts" &&
          collection != "auditEvents" && collection != "auditReleases" && collection != "data" &&
          isTournamentAdmin();
        allow create, delete: if collection != "staff" && collection != "syncConflicts" &&
          collection != "auditEvents" && collection != "auditReleases" && collection != "data" &&
          isTournamentAdmin();
        allow update: if collection != "staff" && collection != "syncConflicts" &&
          collection != "auditEvents" && collection != "auditReleases" && collection != "data" &&
          isTournamentAdmin();
      }

      match /staff/{staffId} {
        allow read, write: if isTournamentAdmin();
      }

      // Conflicting cloud versions are append-only recovery records.
      match /syncConflicts/{conflictId} {
        allow read: if isTournamentAdmin();
        allow create: if isTournamentAdmin();
        allow update, delete: if false;
      }

      // Audit events are append-only; only tournament administrators may read them.
      match /auditEvents/{eventId} {
        allow read: if isTournamentAdmin();
        allow create: if isTournamentAdmin() &&
          request.resource.data.id == eventId &&
          request.resource.data.tournamentId == tournamentId &&
          (
            (request.resource.data.actorType == "user" &&
              request.resource.data.actorId == request.auth.uid) ||
            request.resource.data.actorType == "system"
          );
        allow update, delete: if false;
      }

      // Released audit snapshots are written only by the authorized server route.
      match /auditReleases/{releaseId} {
        allow read, write: if false;
      }

      // Legacy bundled tournament data is administrator-only.
      match /data/{document} {
        allow read, write: if isTournamentAdmin();
      }
    }

    // Direct users collection for profile / tournaments list
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if isGlobalAdmin();
    }
  }
}
