rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tournaments root collection
    match /tournaments/{tournamentId} {
      function isTournamentAdmin() {
        let tournament = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        return request.auth != null && (
          tournament.ownerId == request.auth.uid ||
          (tournament.admins != null && tournament.admins[request.auth.uid] == true)
        );
      }

      allow read: if true; // Public discovery reads root metadata; child data uses the sanitized API.
      allow create: if request.auth != null &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.admins[request.auth.uid] == true;
      allow update, delete: if isTournamentAdmin();

      // Tournament records and private participant data are administrator-only.
      match /{collection}/{document} {
        allow read, write: if collection != "auditEvents" &&
          collection != "auditReleases" &&
          collection != "data" &&
          isTournamentAdmin();
      }

      // Audit events are append-only; only tournament administrators may read them.
      match /auditEvents/{eventId} {
        allow read: if isTournamentAdmin();
        allow create: if isTournamentAdmin() &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.actorType == "user" &&
          request.resource.data.id == eventId &&
          request.resource.data.tournamentId == tournamentId;
        allow update, delete: if false;
      }

      // Released audit snapshots are written only by the authorized server route.
      match /auditReleases/{releaseId} {
        allow read, write: if false;
      }

      // Legacy bundled tournament data is administrator-only.
      match /data/{document} {
        allow read, write: if isTournamentAdmin();
      }
    }

    // Direct users collection for profile / tournaments list
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
