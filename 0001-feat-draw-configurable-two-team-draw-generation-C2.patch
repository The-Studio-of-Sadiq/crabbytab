+
+function stats(id: string, opts: Partial<Omit<RankedTeamStats, "team">> = {}): RankedTeamStats {
+  return {
+    team: { id, tournamentId: "t", name: id, speakers: [], breakCategories: [], speakerCategories: [] } as Team,
